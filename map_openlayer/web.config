<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Increase URL and Query string length limits -->
        <requestLimits maxUrl="81920" maxQueryString="81920" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!-- (Optional) Allow CORS if needed -->
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
